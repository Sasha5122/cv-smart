# ──────────────────────────────────────────────────────────────────────────────
# CVexpres — variabile de mediu
# Copiază în .env.local (dev) sau setează în Vercel (Production + Preview).
# Nicio valoare reală nu se comite în git.
# ──────────────────────────────────────────────────────────────────────────────

# ─── AI (OpenAI) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Varianta de prompt pentru pipeline-ul CV: "liber" (producție) sau "strict" (A/B)
PROMPT_VARIANT=liber

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<proiect>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Doar pe server. Folosită de lib/db/supabase.ts și scripts/create-schema.mjs
SUPABASE_SERVICE_ROLE_KEY=...

# ─── Plăți ───────────────────────────────────────────────────────────────────
# Provider activ: "creem" (producție) sau "paddle" (legacy)
PAYMENT_PROVIDER=creem
# Paywall-ul se activează DOAR dacă e "true" ȘI providerul e complet configurat.
# Playwright îl forțează pe "false" (vezi playwright.config.ts).
NEXT_PUBLIC_PAYWALL_ENABLED=true

# Creem (Merchant of Record) — https://creem.io
CREEM_API_KEY=creem_...
CREEM_PRODUCT_ID=prod_...
CREEM_WEBHOOK_SECRET=whsec_...
# "test" (sandbox, test-api.creem.io) sau "production"
CREEM_ENV=test

# Paddle (legacy; necesar doar dacă PAYMENT_PROVIDER=paddle)
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_ENV=sandbox
PADDLE_PRODUCT_ID=pro_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_...

# Coduri promo (deblochează CV + email fără plată), separate prin virgulă
PROMO_CODES=CODULTAU1,CODULTAU2

# ─── Livrare CV (email + link de re-descărcare) ──────────────────────────────
RESEND_API_KEY=re_...
# adresa la care ajung răspunsurile clienților
REPLY_TO_EMAIL=support@exemplu.ro
# secret random 32+ caractere pentru linkurile HMAC de descărcare:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=...
# dev: http://localhost:3000 · producție: https://www.cvexpres.ro
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Rate limiting (Upstash Redis, REST) ─────────────────────────────────────
# Fără ele, limitarea rulează in-memory per instanță (suficient doar în dev).
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Admin & cron ────────────────────────────────────────────────────────────
# Obligatorie: fără ea panoul /admin este dezactivat.
ADMIN_PASSWORD=...
# Protejează /api/cron/cleanup (Vercel trimite Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=...

# ─── Doar pentru scripturi de test (opțional) ────────────────────────────────
# scripts/test-email-delivery.ts
TEST_EMAIL=
